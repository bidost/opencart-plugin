{#
  Same layout and button id as the OpenCart 4 core payment extensions (bank_transfer, cod).
  Do not put the button in a floated element: the container of a floated element has no height,
  so the next element on the confirm page can cover the button.
#}
<div class="text-end">
  <button type="button" id="button-confirm" class="btn btn-primary" data-href="{{ url_redirect }}">{{ button_confirm }}</button>
</div>
<script type="text/javascript"><!--
$('#button-confirm').on('click', function() {
    location = $(this).attr('data-href');
});
//--></script>
